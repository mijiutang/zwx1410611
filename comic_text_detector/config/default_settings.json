{
  "paths": {
    "models_dir": "data/models",
    "examples_dir": "data/examples",
    "results_dir": "data/results",
    "default_model": "data\\models\\comictextdetector.pt"
  },
  "device": "cpu",
  "detector": {
    "input_size": 1536,
    "conf_thresh": 0.5,
    "nms_thresh": 0.35,
    "mask_thresh": 0.3,
    "allowed_languages": [
      "zh",
      "ja"
    ]
  },
  "gui": {
    "window_size": [
      1200,
      800
    ],
    "recent_files_count": 10,
    "auto_save_results": true
  },
  "output": {
    "save_image": true,
    "save_mask": true,
    "save_json": true,
    "image_format": "jpg",
    "mask_format": "png"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/app.log",
    "max_file_size": "10MB",
    "backup_count": 3
  }
}